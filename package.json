{
  "name": "opencli-plugins",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCLI plugin monorepo: sim + google-trends",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoderLim/sim-open-cli.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/sim",
    "packages/google-trends"
  ],
  "scripts": {
    "build": "npm run build -w opencli-plugin-sim && npm run build -w opencli-plugin-google-trends",
    "build:sim": "npm run build -w opencli-plugin-sim",
    "build:google-trends": "npm run build -w opencli-plugin-google-trends",
    "subdomain-keywords": "node scripts/subdomain-keywords.mjs"
  }
}
